# Unified Deployment Environment Variables
# These are set once on the single Heroku app

# Database (automatically set by Heroku Postgres addon)
DATABASE_URL=postgresql://...

# Backend URL (in production, same as app URL since unified)
# In dev: http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=

# WebSocket URL (in production, wss://yourapp.herokuapp.com)
# In dev: ws://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-secret-key-here

# Frontend URLs (only needed in dev, not used in unified production)
FRONTEND_URLS=http://localhost:3000
