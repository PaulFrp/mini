# Frontend Production Environment Variables
# These should be set as Heroku Config Vars on your FRONTEND app

# Backend API URL (your backend Heroku app)
NEXT_PUBLIC_BACKEND_URL=https://back-end-mini-games-1cb46d8ecc75.herokuapp.com

# WebSocket URL (use wss:// for secure connections)
NEXT_PUBLIC_WS_BASE_URL=wss://back-end-mini-games-1cb46d8ecc75.herokuapp.com

# Set these on Heroku with:
# heroku config:set NEXT_PUBLIC_BACKEND_URL="https://back-end-mini-games-1cb46d8ecc75.herokuapp.com" --app paul-mini-games-228906304104
# heroku config:set NEXT_PUBLIC_WS_BASE_URL="wss://back-end-mini-games-1cb46d8ecc75.herokuapp.com" --app paul-mini-games-228906304104
